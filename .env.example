# --- AI Engine Settings ---
# Gemini APIを利用する場合に必要（Google AI Studioで取得）
GEMINI_API_KEY=your_gemini_api_key_here

# --- Discord Settings (Optional) ---
# Discordのつぶやきを取得する場合に設定
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_target_channel_id_here
# （以前の書き方 CHANNEL_ID= のままでも読み込めます）

# --- Location / Time Settings ---
# 天気を取得する都市名（例: Kofu, Izumo, Siracusa）
CITY_NAME=Tokyo
# タイムゾーン（日記の「1日」の区切りに使います。例: Asia/Tokyo, Europe/Rome）
TIMEZONE=Asia/Tokyo

# --- Storage Settings ---
# 日記（Markdownファイル）の保存先ディレクトリ（絶対パス推奨）
# 例: C:/Users/name/Documents/Obsidian/Vault/Diary
SAVE_DIR=path/to/your/save/directory

# --- Ollama Settings (Optional) ---
# OllamaのAPIエンドポイント（通常はそのままでOK）
OLLAMA_BASE_URL=http://localhost:11434
