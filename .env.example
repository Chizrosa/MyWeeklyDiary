# --- AI Engine Settings ---
# Gemini APIを利用する場合に必要（Google AI Studioで取得）
GEMINI_API_KEY=your_gemini_api_key_here

# --- Discord Settings (Optional) ---
# Discordのつぶやきを取得する場合に設定
DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=your_target_channel_id_here

# --- Storage Settings ---
# 日記（Markdownファイル）の保存先ディレクトリ（絶対パス推奨）
# 例: C:/Users/name/Documents/Obsidian/Vault/Diary
SAVE_DIR=path/to/your/save/directory

# --- Ollama Settings (Optional) ---
# OllamaのAPIエンドポイント（通常はそのままでOK）
OLLAMA_BASE_URL=http://localhost:11434