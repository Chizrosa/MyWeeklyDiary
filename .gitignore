# セキュリティ・環境変数（絶対にアップロードしない！）
.env

# Pythonのキャッシュや仮想環境
__pycache__/
*.pyc
.venv/

# 個人の日記データ（自分の日記をアップロードしないためのブロック）
test_diaries/
diaries/
*.json

# OSが勝手に作る隠しファイル (Windows / Mac)
Thumbs.db
.DS_Store

# Streamlitのローカルシークレット（APIキーなどを書く場合があるため）
.streamlit/secrets.toml

# 万が一エラーログをファイル出力するようにした時用
*.log